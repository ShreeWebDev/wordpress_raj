<%- include('../partials/header') %>
<div class="container-fluid">
  <a href="/vendors" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back</a>
  <div class="d-flex justify-content-between align-items-center mt-1 mb-3 flex-wrap gap-2">
    <div class="page-title"><%= vendor.name %></div>
    <a href="/vendors/<%= vendor.id %>/edit" class="btn btn-outline-primary btn-sm"><i class="bi bi-pencil me-1"></i>Edit</a>
  </div>

  <div class="row g-3">
    <div class="col-12 col-md-4 col-lg-3">
      <div class="form-card">
        <h6 class="fw-bold mb-3">Vendor Info</h6>
        <div class="mb-2"><span class="text-muted small">Name</span><div class="fw-semibold"><%= vendor.name %></div></div>
        <div class="mb-2"><span class="text-muted small">Contact</span><div class="fw-semibold"><%= vendor.contact_no || '—' %></div></div>
        <div><span class="text-muted small">Address</span><div class="fw-semibold"><%= vendor.address || '—' %></div></div>
      </div>
    </div>
    <div class="col-12 col-md-8 col-lg-9">
      <div class="form-card">
        <h6 class="fw-bold mb-3">Linked Products (<%= vendor.productVendors?.length || 0 %>)</h6>
        <div class="row g-2">
          <% (vendor.productVendors || []).forEach(pv => { %>
          <div class="col-6 col-md-4 col-lg-3">
            <a href="/products/<%= pv.product?.id %>" class="text-decoration-none">
              <div class="product-card p-2 text-center">
                <% if (pv.product?.image_path) { %>
                <img src="<%= pv.product.image_path %>" class="img-fluid rounded mb-1" style="height:80px;object-fit:cover;width:100%;">
                <% } else { %>
                <div class="bg-light rounded mb-1 d-flex align-items-center justify-content-center" style="height:80px;">
                  <i class="bi bi-box text-muted" style="font-size:28px;"></i>
                </div>
                <% } %>
                <div class="sku-badge" style="font-size:10px;"><%= pv.product?.sku %></div>
                <div class="small fw-semibold mt-1 text-dark"><%= pv.product?.name %></div>
                <div class="text-success small">¥<%= pv.rate_rmb ? parseFloat(pv.rate_rmb).toFixed(2) : '—' %></div>
              </div>
            </a>
          </div>
          <% }) %>
          <% if (!vendor.productVendors?.length) { %>
          <div class="col-12 text-center text-muted py-4">No products linked.</div>
          <% } %>
        </div>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
