<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %> | Wholesaledock</title>
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/css/app.css">
</head>
<body>

<!-- Top Navbar -->
<nav class="navbar navbar-dark bg-primary fixed-top px-3" style="z-index:1050;">
  <div class="d-flex align-items-center gap-2">
    <button class="btn btn-link text-white p-0 me-2 d-lg-none" id="sidebarToggle"><i class="bi bi-list fs-4"></i></button>
    <a class="navbar-brand fw-bold mb-0 h1 fs-5" href="/dashboard">
      <i class="bi bi-box-seam me-1"></i>Wholesaledock
    </a>
    <span class="d-none d-md-inline text-white-50 small">Procurement Order Management</span>
  </div>
  <div class="d-flex align-items-center gap-3">
    <!-- Notification Bell -->
    <div class="dropdown">
      <button class="btn btn-link text-white p-0 position-relative" id="notifBtn" data-bs-toggle="dropdown">
        <i class="bi bi-bell fs-5"></i>
        <span class="badge bg-danger position-absolute top-0 start-100 translate-middle rounded-pill" id="notifCount" style="display:none;font-size:10px;"></span>
      </button>
      <div class="dropdown-menu dropdown-menu-end p-0" id="notifDropdown" style="width:340px;max-height:420px;overflow-y:auto;">
        <div class="p-3 border-bottom fw-semibold bg-light">Notifications</div>
        <div id="notifList"><div class="p-3 text-muted text-center small">Loading...</div></div>
      </div>
    </div>
    <!-- User Menu -->
    <div class="dropdown">
      <button class="btn btn-link text-white p-0 d-flex align-items-center gap-1" data-bs-toggle="dropdown">
        <div class="avatar-circle"><%= user.name.charAt(0).toUpperCase() %></div>
        <span class="d-none d-md-inline small"><%= user.name %></span>
        <i class="bi bi-chevron-down small"></i>
      </button>
      <ul class="dropdown-menu dropdown-menu-end">
        <li><span class="dropdown-item-text text-muted small"><%= user.role.toUpperCase() %></span></li>
        <li><hr class="dropdown-divider"></li>
        <li><a class="dropdown-item" href="/auth/profile"><i class="bi bi-person me-2"></i>Edit Profile</a></li>
        <li><a class="dropdown-item text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i>Logout</a></li>
      </ul>
    </div>
  </div>
</nav>

<!-- Sidebar -->
<div class="sidebar" id="sidebar">
  <nav class="sidebar-nav">
    <a href="/dashboard" class="sidebar-link <%= locals.title === 'Dashboard' ? 'active' : '' %>">
      <i class="bi bi-speedometer2"></i><span>Dashboard</span>
    </a>
    <a href="/products" class="sidebar-link <%= locals.title && locals.title.includes('Product') ? 'active' : '' %>">
      <i class="bi bi-box"></i><span>Products</span>
    </a>
    <a href="/orders" class="sidebar-link <%= locals.title && locals.title.includes('Order') ? 'active' : '' %>">
      <i class="bi bi-cart3"></i><span>Orders</span>
    </a>
    <% if (user.role !== 'sales') { %>
    <a href="/vendors" class="sidebar-link <%= locals.title && locals.title.includes('Vendor') ? 'active' : '' %>">
      <i class="bi bi-building"></i><span>Vendors</span>
    </a>
    <% } %>
    <% if (user.role === 'admin') { %>
    <a href="/settings" class="sidebar-link <%= locals.title === 'Settings' ? 'active' : '' %>">
      <i class="bi bi-gear"></i><span>Settings</span>
    </a>
    <% } %>
  </nav>
</div>

<!-- Sidebar overlay for mobile -->
<div class="sidebar-overlay" id="sidebarOverlay"></div>

<!-- Main Content -->
<main class="main-content">
