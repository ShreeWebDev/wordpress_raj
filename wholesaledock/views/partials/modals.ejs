<!-- Comments Modal -->
<div class="modal fade" id="commentsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title"><i class="bi bi-chat-dots me-2"></i>Order Comments</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body p-0">
        <div id="commentThread" style="height:320px;overflow-y:auto;padding:16px;display:flex;flex-direction:column;gap:10px;background:#f8f9fa;"></div>
        <div class="p-3 border-top bg-white">
          <div class="input-group">
            <input type="text" id="commentInput" class="form-control" placeholder="Type a message..." maxlength="500">
            <button class="btn btn-primary" id="sendCommentBtn"><i class="bi bi-send"></i></button>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- Attachments Modal -->
<div class="modal fade" id="attachmentsModal" tabindex="-1">
  <div class="modal-dialog modal-dialog-centered">
    <div class="modal-content">
      <div class="modal-header"><h5 class="modal-title"><i class="bi bi-paperclip me-2"></i>Attachments</h5><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div>
      <div class="modal-body">
        <div id="attachmentList" class="d-flex flex-column gap-2 mb-3"></div>
        <div class="border-top pt-3">
          <label class="form-label fw-semibold small">Upload Files</label>
          <input type="file" id="attachUpload" class="form-control form-control-sm" multiple accept=".jpg,.jpeg,.png,.pdf,.doc,.docx,.xls,.xlsx">
          <button class="btn btn-primary btn-sm mt-2 w-100" id="uploadAttachBtn"><i class="bi bi-cloud-upload me-1"></i>Upload</button>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
let currentCommentOrderId = null;
let currentAttachOrderId = null;
const currentUserId = <%= typeof user !== 'undefined' ? user.id : 0 %>;
const currentUserRole = '<%= typeof user !== "undefined" ? user.role : "" %>';

function openComments(orderId) {
  currentCommentOrderId = orderId;
  document.getElementById('commentThread').innerHTML = '<div class="text-center text-muted small">Loading...</div>';
  loadComments(orderId);
  new bootstrap.Modal(document.getElementById('commentsModal')).show();
}

async function loadComments(orderId) {
  // Fetch order detail for comments via inline data or separate endpoint
  // For simplicity, we use the detail endpoint
  try {
    const res = await fetch(`/orders/shipments/0/detail`); // fallback; ideally order detail endpoint
    // Since we don't have a separate order-detail endpoint, use embedded data
  } catch {}
}

// Re-use: comments are passed as data attributes; this modal reads from server refresh pattern
// We'll post comment and refresh
document.getElementById('commentInput')?.addEventListener('keydown', function(e) {
  if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendComment(); }
});
document.getElementById('sendCommentBtn')?.addEventListener('click', sendComment);

async function sendComment() {
  const msg = document.getElementById('commentInput').value.trim();
  if (!msg || !currentCommentOrderId) return;
  const res = await apiCall(`/orders/${currentCommentOrderId}/comment`, 'POST', { message: msg });
  if (res.success) {
    document.getElementById('commentInput').value = '';
    appendComment(res.comment);
    const thread = document.getElementById('commentThread');
    thread.scrollTop = thread.scrollHeight;
  } else showToast(res.message, 'error');
}

function appendComment(c) {
  const thread = document.getElementById('commentThread');
  const isMe = c.user_id === currentUserId;
  const div = document.createElement('div');
  div.className = `comment-bubble ${isMe ? (currentUserRole === 'admin' ? 'admin' : 'agent') : (c.role === 'admin' ? 'admin' : 'agent')}`;
  div.innerHTML = `
    <div class="bubble-inner">
      <div class="fw-semibold" style="font-size:11px;margin-bottom:3px;">${c.user_name}</div>
      ${c.message}
    </div>
    <div class="comment-time ${isMe ? 'text-end' : ''}">${new Date(c.timestamp).toLocaleString()}</div>`;
  thread.appendChild(div);
}

function renderComments(comments) {
  const thread = document.getElementById('commentThread');
  thread.innerHTML = '';
  if (!comments?.length) { thread.innerHTML = '<div class="text-center text-muted small py-4">No messages yet.</div>'; return; }
  comments.forEach(appendComment);
  thread.scrollTop = thread.scrollHeight;
}

function openCommentsDirect(orderId, comments) {
  currentCommentOrderId = orderId;
  renderComments(comments);
  new bootstrap.Modal(document.getElementById('commentsModal')).show();
}

function openAttachments(orderId) {
  currentAttachOrderId = orderId;
  new bootstrap.Modal(document.getElementById('attachmentsModal')).show();
}

function renderAttachments(attachments) {
  const list = document.getElementById('attachmentList');
  if (!attachments?.length) { list.innerHTML = '<div class="text-muted small text-center py-2">No attachments yet.</div>'; return; }
  list.innerHTML = attachments.map(a => `
    <div class="attach-item">
      <i class="bi bi-${getFileIcon(a.filename)} text-muted"></i>
      <a href="${a.path}" target="_blank">${a.filename}</a>
    </div>`).join('');
}

function getFileIcon(filename) {
  const ext = filename?.split('.').pop()?.toLowerCase();
  if (['jpg','jpeg','png','gif'].includes(ext)) return 'image';
  if (ext === 'pdf') return 'file-pdf';
  if (['xls','xlsx'].includes(ext)) return 'file-spreadsheet';
  if (['doc','docx'].includes(ext)) return 'file-word';
  return 'file-earmark';
}

document.getElementById('uploadAttachBtn')?.addEventListener('click', async () => {
  const files = document.getElementById('attachUpload').files;
  if (!files.length) { showToast('Select files to upload', 'warning'); return; }
  const formData = new FormData();
  for (const f of files) formData.append('files', f);
  const btn = document.getElementById('uploadAttachBtn');
  btn.disabled = true; btn.textContent = 'Uploading...';
  try {
    const res = await fetch(`/orders/${currentAttachOrderId}/attachments`, { method: 'POST', body: formData });
    const d = await res.json();
    if (d.success) {
      showToast(`${d.attachments.length} file(s) uploaded`);
      document.getElementById('attachUpload').value = '';
      const list = document.getElementById('attachmentList');
      d.attachments.forEach(a => {
        const div = document.createElement('div');
        div.className = 'attach-item';
        div.innerHTML = `<i class="bi bi-${getFileIcon(a.filename)} text-muted"></i><a href="${a.path}" target="_blank">${a.filename}</a>`;
        list.appendChild(div);
      });
    } else showToast(d.message, 'error');
  } catch { showToast('Upload failed', 'error'); }
  finally { btn.disabled = false; btn.innerHTML = '<i class="bi bi-cloud-upload me-1"></i>Upload'; }
});
</script>
