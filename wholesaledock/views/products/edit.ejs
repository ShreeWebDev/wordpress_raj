<%- include('../partials/header') %>
<div class="container-fluid">
  <a href="/products/<%= product.id %>" class="text-muted small text-decoration-none"><i class="bi bi-arrow-left me-1"></i>Back</a>
  <div class="page-title mt-1">Edit Product</div>
  <div class="row justify-content-center">
    <div class="col-12 col-md-7 col-lg-5">
      <div class="form-card">
        <% if (error) { %><div class="alert alert-danger py-2"><%= error %></div><% } %>
        <form action="/products/<%= product.id %>/edit" method="POST" enctype="multipart/form-data">
          <div class="mb-3">
            <label class="form-label">Product Name <span class="text-danger">*</span></label>
            <input type="text" name="name" class="form-control" value="<%= product.name %>" required>
          </div>
          <div class="mb-3">
            <label class="form-label">SKU <span class="text-danger">*</span></label>
            <input type="text" name="sku" class="form-control" value="<%= product.sku %>" required style="text-transform:uppercase;">
          </div>
          <div class="mb-3">
            <label class="form-label">Product Image</label>
            <% if (product.image_path) { %>
            <div class="mb-2">
              <img src="<%= product.image_path %>" style="max-height:100px;border-radius:8px;" alt="">
            </div>
            <% } %>
            <input type="file" name="image" class="form-control" accept="image/*">
            <small class="text-muted">Leave blank to keep current image.</small>
          </div>
          <div class="mb-4">
            <div class="form-check form-switch">
              <input class="form-check-input" type="checkbox" name="is_active" id="isActive" value="on" <%= product.is_active ? 'checked' : '' %>>
              <label class="form-check-label" for="isActive">Active</label>
            </div>
          </div>
          <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary flex-grow-1">Save Changes</button>
            <a href="/products/<%= product.id %>" class="btn btn-outline-secondary">Cancel</a>
          </div>
        </form>
      </div>
    </div>
  </div>
</div>
<%- include('../partials/footer') %>
