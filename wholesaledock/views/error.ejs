<% if (typeof user !== 'undefined' && user) { %>
<%- include('partials/header') %>
<div class="container-fluid">
  <div class="d-flex flex-column align-items-center justify-content-center" style="min-height:50vh;">
    <i class="bi bi-exclamation-circle text-danger" style="font-size:64px;"></i>
    <h2 class="mt-3 fw-bold"><%= title || 'Error' %></h2>
    <p class="text-muted"><%= message || 'Something went wrong.' %></p>
    <a href="/dashboard" class="btn btn-primary mt-2">Return to Dashboard</a>
  </div>
</div>
<%- include('partials/footer') %>
<% } else { %>
<!DOCTYPE html>
<html><head><meta charset="UTF-8"><title>Error</title>
<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css">
</head><body class="bg-light">
<div class="container d-flex flex-column align-items-center justify-content-center min-vh-100">
  <i class="bi bi-exclamation-circle text-danger" style="font-size:64px;"></i>
  <h2 class="mt-3 fw-bold"><%= title || 'Error' %></h2>
  <p class="text-muted"><%= message || 'Something went wrong.' %></p>
  <a href="/auth/login" class="btn btn-primary mt-2">Back to Login</a>
</div>
</body></html>
<% } %>
